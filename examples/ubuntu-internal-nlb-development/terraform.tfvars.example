#------------------------------------------------------------------------------
# Common
#------------------------------------------------------------------------------
# Update if needed
region         = "us-east-1"
environment_name = "development"
tag_owner        = "email@example.com"

#------------------------------------------------------------------------------
# Compute
#------------------------------------------------------------------------------
# key_name is auto-generated by tls.tf — only set this if you want to use
# an existing AWS key pair instead. Override here if needed.
key_name = ""

#------------------------------------------------------------------------------
# Networking
# instance_subnets, internal_nlb_subnets and vpc_id are resolved automatically
# from the default VPC in the current account/region. Only set these if you
# want to target a specific VPC or subnets.
#------------------------------------------------------------------------------
vpc_id               = null
instance_subnets     = []
internal_nlb_subnets = []

